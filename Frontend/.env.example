# Backend API bazaviy manzili. Docker (nginx) orqali ishga tushirilganda nisbiy "/api"
# ishlatiladi (Frontend/nginx.conf backendga proxy qiladi). Faqat `npm run dev` (Vite
# dev server, proxy yo'q) uchun "http://localhost:8000/api" ga o'zgartiring.
VITE_API_BASE_URL=/api

# Telegram bot havolasi (standart: https://t.me/Logistika_AIbot).
# Zarur bo'lsa override qiling; build vaqtida ishlatiladi.
VITE_TELEGRAM_BOT_URL=

# Support mikroservisi (murojaatlar/ticketlar). Bo'sh qoldiring — shunda `/support/...`
# frontend bilan bir originda so'raladi va proxy uni 8010-portga uzatadi (dev uchun
# vite.config.ts, prod uchun Frontend/nginx.conf). Faqat proxy'siz, to'g'ridan-to'g'ri
# ulanish kerak bo'lgandagina to'ldiring — u holda support tomonda CORS yoqilishi shart.
# VITE_SUPPORT_BASE_URL=http://localhost:8010

# MapLibre vector style URL. OpenFreeMap Liberty needs no API key and provides
# attribution through its style metadata. Override for a compatible hosted style.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# DIQQAT: FRONTEND_PORT / FRONTEND_DEV_PORT bu yerda EMAS, repo ildizidagi `.env` da
# beriladi — docker-compose fayllari faqat o'sha faylni o'qiydi. Shu fayl esa faqat
# `npm run dev` (Docker'siz) uchun kerak.
